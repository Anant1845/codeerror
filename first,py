import os

# 1. Get current directory
print("1. Current Directory:", os.getcwd())

# 2. Create a directory
os.mkdir("MyFolder")
print("2. Directory Created")

# 3. List files and folders
print("3. List:", os.listdir())

# 4. Check directory exists
print("4. Exists:", os.path.exists("MyFolder"))

# 5. Check whether it is a directory
print("5. Is Directory:", os.path.isdir("MyFolder"))

# 6. Change current directory
os.chdir("MyFolder")
print("6. Changed Directory:", os.getcwd())

# 7. Go back to previous directory
os.chdir("..")
print("7. Back to:", os.getcwd())

# 8. Rename directory
os.rename("MyFolder", "NewFolder")
print("8. Directory Renamed")

# 9. Get absolute path
print("9. Absolute Path:", os.path.abspath("NewFolder"))

# 10. Remove directory
os.rmdir("NewFolder")
print("10. Directory Removed")

